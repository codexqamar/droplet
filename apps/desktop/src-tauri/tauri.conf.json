{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DROPLET",
  "mainBinaryName": "droplet",
  "identifier": "com.droplet.desktop",
  "version": "0.3.1",
  "build": {
    "frontendDist": "../../web/dist-desktop"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "title": "DROPLET",
        "width": 1400,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 700,
        "center": true,
        "decorations": false,
        "transparent": false,
        "shadow": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "publisher": "DROPLET",
    "shortDescription": "DROPLET trade desktop",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../daemon/dist/droplet-daemon/": "daemon/",
      "icons/icon.ico": "droplet.ico"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico",
        "installerHooks": "nsis/hooks.nsh",
        "uninstallerIcon": "icons/icon.ico"
      }
    }
  }
}
