# DROPLET production environment. Copy the values into Coolify → Environment Variables
# (or into .env.production for `docker run --env-file`). Never commit real values.
#
# Generate secrets (any machine with Node 18+):
#   node -e "const c=require('crypto');console.log('DROPLET_SIGNING_SECRET='+c.randomBytes(32).toString('base64url'));console.log('DROPLET_MFA_ENC_KEY='+c.randomBytes(32).toString('hex'));console.log('DROPLET_OPS_TOKEN='+c.randomBytes(32).toString('base64url'));console.log('POSTGRES_PASSWORD='+c.randomBytes(24).toString('base64url'))"

# Public address of the portal, exactly as customers open it (https in production).
PORTAL_ORIGIN=https://portal.example.com

# PostgreSQL. With docker-compose.yml only the password is needed; with a Coolify-managed
# database instead, set DATABASE_URL to its internal connection string.
POSTGRES_PASSWORD=change-me
# DATABASE_URL=postgresql://user:password@host:5432/droplet?schema=public

# Signing key for download links, enrollment codes and desktop sync tokens.
DROPLET_SIGNING_SECRET=change-me
# AES-256 key (64 hex chars) encrypting authenticator secrets at rest.
# Keep it safe: losing it means every user must set up their authenticator again.
DROPLET_MFA_ENC_KEY=change-me

# Optional: enables PUT /v1/ops/releases so the Windows build can publish desktop installers.
DROPLET_OPS_TOKEN=
